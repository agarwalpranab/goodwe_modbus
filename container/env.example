# Copy this file to .env and fill in your values.
# docker compose automatically loads .env from the same directory.

# ------------------------------------------------------------------
# Inverter
# ------------------------------------------------------------------
INVERTER_HOST=192.168.1.100
INVERTER_PROTOCOL=UDP          # UDP | TCP
# INVERTER_PORT=8899           # default: 8899 (UDP) or 502 (TCP)
INVERTER_FAMILY=auto           # auto | ET | EH | BT | BH | ES | EM | BP | DT | MS | NS | XS
# INVERTER_COMM_ADDR=247       # default: 0xF7 = 247
SCAN_INTERVAL=30               # seconds

# ------------------------------------------------------------------
# MQTT broker
# ------------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=goodwe
MQTT_CLIENT_ID=goodwe-modbus

# ------------------------------------------------------------------
# Home Assistant MQTT Discovery
# ------------------------------------------------------------------
MQTT_HA_DISCOVERY=true
MQTT_HA_DISCOVERY_PREFIX=homeassistant

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=INFO
